# Local binaries and development processes
/hy
/.air/
/internal/adapter/claudecode/sidecar/dist/

# Dependencies and generated frontend output
node_modules/
/web/dist/
/cmd/hy/webdist/assets/
/cmd/hy/webdist/index.html
*.tsbuildinfo

# Worktrees hy provisions for its own sessions, which live inside the checkout
# by default and are complete repositories in their own right.
/.worktrees/

# Written into a worktree by scripts/hy-provision.mjs, and true only of that
# one worktree. .hy/project.json is committed; everything else under .hy is not.
/.hy/*
!/.hy/project.json
/WORKTREE.md

# Runtime data
*.db
*.db-wal
*.db-shm

# Local configuration and credentials
.env
.env.*
!.env.example

# Test and editor/OS output
coverage/
*.coverprofile
.DS_Store
*.swp
