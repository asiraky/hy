#!/bin/sh
# Starts the development server: the Go binary under air, and Vite beside it.
#
# This exists rather than a line in package.json because a worktree needs its
# own ports and its own database, and there is nowhere to pass flags through.
# scripts/omniplex-provision.mjs writes .omniplex/worktree.env when it provisions one; the
# main checkout has no such file and falls back to the standard ports.
set -e
cd "$(dirname "$0")/.."

if [ -f .omniplex/worktree.env ]; then
  echo "omniplex: using the ports and database in .omniplex/worktree.env"
  # shellcheck disable=SC1091
  . ./.omniplex/worktree.env
fi

OMNIPLEX_PORT="${OMNIPLEX_PORT:-8787}"
OMNIPLEX_VITE_PORT="${OMNIPLEX_VITE_PORT:-5199}"
export OMNIPLEX_PORT OMNIPLEX_VITE_PORT
[ -n "${OMNIPLEX_DB:-}" ] && export OMNIPLEX_DB

exec concurrently -k -n go,web -c cyan,magenta "air" "./scripts/web vite"
